{
  "_comment": "AI创作平台配置文件 - 请将此文件复制为 config.json，然后填入你的各项API Key",

  "newapi": {
    "api_key": "your-newapi-key-here",
    "api_base": "https://api.voct.top",
    "text_model": "deepseek-ai/DeepSeek-V3",
    "image_model": "doubao-seedream-4-0-250828",
    "enabled": true,
    "_comment": "New API统一接口，支持文本对话和图像生成"
  },

  "suno": {
    "api_key": "your-suno-api-key-here",
    "api_base": "https://api.sunoapi.org/api/v1",
    "upload_base": "https://sunoapiorg.redpandaai.co/api",
    "enabled": true
  },

  "image_generation": {
    "provider": "stable-diffusion",
    "api_key": "your-image-generation-api-key",
    "api_base": "https://api.stability.ai/v1",
    "models": ["sd-xl-1.0", "sd-2.1"],
    "default_model": "sd-xl-1.0",
    "enabled": false,
    "_comment": "支持 Stable Diffusion, DALL-E 等，请根据provider修改api_base"
  },

  "video_generation": {
    "provider": "jimeng",
    "api_key": "your-jimeng-api-key",
    "api_base": "https://api.jimeng.com/v1",
    "models": ["jimeng-v1", "jimeng-v2"],
    "default_model": "jimeng-v2",
    "enabled": false,
    "_comment": "即梦视频生成API配置"
  },

  "llm": {
    "provider": "deepseek",
    "api_key": "your-deepseek-api-key",
    "api_base": "https://api.deepseek.com/v1",
    "models": ["deepseek-chat", "deepseek-coder"],
    "default_model": "deepseek-chat",
    "enabled": false,
    "_comment": "LLM大语言模型配置，支持: deepseek, openai, qwen, zhipu等"
  },

  "text_processing": {
    "provider": "deepseek",
    "api_key": "your-deepseek-api-key",
    "api_base": "https://api.deepseek.com/v1",
    "models": ["deepseek-chat", "deepseek-coder"],
    "default_model": "deepseek-chat",
    "enabled": false,
    "_comment": "【已废弃】请使用llm配置"
  },

  "audio_processing": {
    "provider": "custom",
    "api_key": "your-audio-api-key",
    "api_base": "https://api.audio-process.com/v1",
    "models": ["whisper-large", "audio-enhance-v1"],
    "default_model": "audio-enhance-v1",
    "enabled": false,
    "_comment": "音频处理API配置，支持语音识别、增强等"
  },

  "server": {
    "host": "0.0.0.0",
    "port": 8000,
    "output_dir": "outputs",
    "max_upload_size_mb": 50,
    "poll_interval_seconds": 8,
    "max_poll_timeout_seconds": 900
  }
}
